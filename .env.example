


ORIGINRAG_APP_PROFILE=full
ORIGINWRITE_MAX_PARALLEL_BUILDS=2
ORIGINWRITE_LANGUAGE_CHECK=1
ORIGINRAG_BIB_DIR=/absolute/path/to/OriginRAG/bib
ORIGINRAG_DOMAIN=malaria
ORIGINRAG_OPENALEX_API_KEY=
ORIGINRAG_UNPAYWALL_EMAIL=


ORIGINRAG_OLLAMA_BASE_URL=http://localhost:11434
ORIGINRAG_OLLAMA_MODEL=qwen3:4b
ORIGINRAG_OLLAMA_PLANNER_MODEL=qwen3:4b
ORIGINRAG_OLLAMA_ANSWER_MODEL=qwen3:4b
ORIGINRAG_QWEN_BASE_URL=http://localhost:11434
ORIGINRAG_QWEN_MODEL=qwen3:4b
ORIGINRAG_LLM_TIMEOUT_SECONDS=1200
ORIGINRAG_OLLAMA_NUM_CTX=16384
ORIGINRAG_OLLAMA_NUM_PREDICT=2200
ORIGINRAG_OLLAMA_CLI_FALLBACK=1
ORIGINRAG_OLLAMA_FORCE_CLI=0
ORIGINRAG_LLM_QUEUE_DIR=outputs/llm_queue
ORIGINRAG_QUEUE_MODEL=qwen3:4b
